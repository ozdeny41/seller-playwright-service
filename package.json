{
  "name": "seller-playwright-service",
  "version": "1.0.0",
  "description": "Seller Playwright Service - Seller bilgileri çekme servisi",
  "main": "src/server.js",
  "scripts": {
    "db:migrate": "sequelize-cli db:migrate --config config/database.js --models-path models",
    "db:migrate:undo": "sequelize-cli db:migrate:undo --config config/database.js --models-path models",
    "db:seed": "sequelize-cli db:seed:all --config config/database.js --models-path models",
    "db:seed:undo": "sequelize-cli db:seed:undo:all --config config/database.js --models-path models",

    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "echo \"No tests specified\" && exit 0"
    "test:db": "node test-db.js",

  },
  "keywords": [
    "vixify",
    "playwright",
    "seller",
    "scraping"
  ],
  "author": "Vixify Team",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": "20",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "pg": "^8.18.0",
    "pg-hstore": "^2.3.4",
    "playwright": "^1.40.0",
    "sequelize": "^6.37.7"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "sequelize-cli": "^6.6.5"
  }
}
